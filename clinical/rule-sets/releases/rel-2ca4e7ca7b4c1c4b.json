    {
      "ruleId": "ACR-FLEISCHNER-GGN-GTE6MM",
      "revisionId": "ACR-FLEISCHNER-GGN-GTE6MM-r1",
      "approvalStatus": "Approved",
      "approvalEvent": {
        "by": "stratjan",
        "at": "2026-09-06"
      },
      "kind": "atomic-clinical-rule",
      "recommendationSourceId": "fleischner",
      "clinicalPathwayId": "incidental-solitary-pure-ggn-initial",
      "measurementBasis": "diameter",
      "diameterConditions": [
        {
          "field": "nodule_size_mm",
          "op": "gte",
          "value": 6
        }
      ],
      "measurementConventionId": "fleischner-2017-average-diameter",
      "recommendation": {
        "persistenceConfirmation": {
          "label": "CT to confirm persistence",
          "timing": {
            "kind": "specified",
            "intervals": [
              "6-12 months"
            ]
          }
        },
        "ifPersistent": {
          "label": "CT surveillance",
          "timing": {
            "kind": "specified",
            "intervals": [
              "every 2 years until 5 years"
            ]
          }
        },
        "rationale": "Fleischner recommends, for a solitary, pure ground-glass/non-solid, incidental pulmonary nodule 6mm or greater in diameter, in a patient >=35 years old with no known malignancy history and not immunocompromised: a CT at 6-12 months to confirm persistence, and, only if the nodule is confirmed persistent, continued CT surveillance every 2 years until 5 years. The Local SOP's own wording states this boundary as '>6mm'; the governed executable boundary is '>=6mm', per explicit clinical HITL approval treating the Local SOP wording as an imprecise transcription of the underlying Fleischner 2017 source table (see clinical/sources/local-sop.json findings)."
      },
      "provenanceAnchors": [
